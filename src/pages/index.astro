    </div>
    <div>
      <h6 class="display" style="font-size:18px;margin:0 0 14px;color:var(--amarillo)">Catálogo</h6>
      {['#catalogo·Por forma', '#tamanos·Por tamaño', '#materiales·Materiales', '#configurador·Arma tu piñata', '#escuelas·Escuelas y mayoreo'].map(l => {
