      <a href="tel:+525512345678" style="font-size:14px;color:rgba(253,243,223,.7);text-decoration:none;line-height:2;display:block">+52 55 1234 5678</a>
      <a href="#pedido" style="font-size:14px;color:rgba(253,243,223,.7);text-decoration:none;line-height:2;display:block">Formulario</a>
