<style>
  .pico-card:hover { transform: translate(-3px,-3px); box-shadow: 11px 11px 0 var(--tinta) !important; }
  .ver-modelos-btn:hover { background: var(--amarillo) !important; }
  .opt-btn:hover:not(.active) { background: var(--amarillo) !important; }
  .opt-btn.active { background: var(--guinda) !important; color: #fff !important; border-color: var(--guinda) !important; }
  .gallery-card { transition: transform .15s, box-shadow .15s; }
  .gallery-card:hover { transform: translate(-2px,-2px); box-shadow: 9px 9px 0 var(--tinta) !important; }
  #gallery-modal.open { display: flex !important; }
  #modal-svg-slot svg { animation: fadeUp .25s ease; }
  #modal-prev:hover, #modal-next:hover { background: var(--amarillo) !important; }
  #modal-close:hover { background: var(--guinda) !important; color: #fff; }
  #nav-toggle:hover { background: var(--amarillo) !important; }
  #nav-links.open { display: flex !important; }
  @media (max-width: 900px) {
    #nav-bar { padding-left: 20px !important; padding-right: 20px !important; }
    #nav-links {
      display: none !important;
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; gap: 2px; padding: 10px 20px 18px !important;
      background: var(--crema); border-bottom: 2px dashed rgba(168,35,31,.25);
      box-shadow: 0 8px 16px rgba(0,0,0,.08); font-size: 16px !important;
    }
    #nav-links li { border-top: 1px solid rgba(42,26,16,.08); }
    #nav-links li a { display: block; padding: 13px 4px; }
    #nav-toggle { display: flex !important; }
    section > div[style*="grid-template-columns:1.05fr"],
    section > div[style*="grid-template-columns:1fr 1fr"],
    section > div[style*="grid-template-columns:1fr 1.1fr"],
    section > div[style*="grid-template-columns:1.4fr"] { grid-template-columns: 1fr !important; }
    section > div[style*="grid-template-columns:repeat(3"] { grid-template-columns: 1fr !important; }
    #galeria-grid { grid-template-columns: repeat(2,1fr) !important; }
    section[style*="padding:0 48px"],
    div[style*="padding:0 48px"],
    div[style*="padding:24px 48px 0"] { padding-left: 20px !important; padding-right: 20px !important; }
    #footer-bottom { flex-direction: column !important; gap: 6px; text-align: center; padding-bottom: 76px !important; }
  }
  @media (max-width: 560px) {
    #nav-cta-text { display: none; }
    nav a[href^="mailto"] { padding: 11px !important; }
    #tamanos-row { flex-wrap: wrap !important; justify-content: center !important; row-gap: 28px; }
    #tamanos-row > div { flex: 0 1 30% !important; min-width: 96px !important; }
  }
</style>

<script>
  // ── Menú móvil (hamburguesa) ───────────────────────────────────────
  const navToggle = document.getElementById('nav-toggle');
  const navLinks  = document.getElementById('nav-links');
  const navIconOpen  = document.getElementById('nav-icon-open');
  const navIconClose = document.getElementById('nav-icon-close');

  function closeNavMenu() {
    navLinks?.classList.remove('open');
    navToggle?.setAttribute('aria-expanded', 'false');
    if (navIconOpen)  navIconOpen.style.display  = '';
    if (navIconClose) navIconClose.style.display = 'none';
  }

  navToggle?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', String(!!isOpen));
    if (navIconOpen)  navIconOpen.style.display  = isOpen ? 'none' : '';
    if (navIconClose) navIconClose.style.display = isOpen ? '' : 'none';
  });

  navLinks?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeNavMenu));

  // ── Formulario cotización por correo ────────────────────────────────
  document.getElementById('cotiza-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = (document.getElementById('f-nombre') as HTMLInputElement).value.trim();
    const tel    = (document.getElementById('f-tel')    as HTMLInputElement).value.trim();
    const fecha  = (document.getElementById('f-fecha')  as HTMLInputElement).value;
    const desc   = (document.getElementById('f-desc')   as HTMLTextAreaElement).value.trim();
    const body   = `Hola, quiero cotizar una piñata:\n\nNombre: ${nombre || '—'}\nTeléfono: ${tel || '—'}\nFecha del evento: ${fecha || '—'}\n\n¿Qué piñata quiero?\n${desc || '—'}\n\n¿Me dan precio y disponibilidad?`;
    window.location.href = `mailto:hola@pinataslaestella.com?subject=${encodeURIComponent('Cotización de piñata')}&body=${encodeURIComponent(body)}`;
    const btn = document.getElementById('form-submit-btn')!;
    btn.textContent = '¡Listo! Revisá tu app de correo ✓';
    btn.style.background = 'var(--verde)';
  });

  // ── Galería modal ────────────────────────────────────────────────────
  const galeriaData: { nombre: string; mat: string }[] = [
    { nombre: 'Estrella 7 picos · Guinda metálico',  mat: 'Picos metálicos · Cuerpo papelitos' },
    { nombre: 'Estrella 5 picos · Verde crepé',      mat: 'Picos crepé · Cuerpo papel china' },
    { nombre: 'Estrella 8 picos · Rosa metálico',    mat: 'Picos metálicos · Cuerpo papel chino' },
    { nombre: 'Estrella 5 picos · Azul metálico',    mat: 'Picos metálicos · Cuerpo papelitos' },
    { nombre: 'Estrella 7 picos · Guinda y plata',   mat: 'Picos metálicos · Cuerpo papel chino' },
    { nombre: 'Estrella 8 picos · Verde y plata',    mat: 'Picos crepé · Cuerpo papel china' },
    { nombre: 'Estrella 5 picos · Rosa y azul',      mat: 'Picos metálicos · Cuerpo papelitos' },
  ];

  const modal      = document.getElementById('gallery-modal')!;
  const backdrop   = document.getElementById('modal-backdrop')!;
  const closeBtn   = document.getElementById('modal-close')!;
  const prevBtn    = document.getElementById('modal-prev')!;
  const nextBtn    = document.getElementById('modal-next')!;
  const svgSlot    = document.getElementById('modal-svg-slot')!;
  const nombreEl   = document.getElementById('modal-nombre')!;
  const matEl      = document.getElementById('modal-mat')!;
  const counterEl  = document.getElementById('modal-counter')!;
  const waLink     = document.getElementById('modal-wa') as HTMLAnchorElement;
  const dots       = document.querySelectorAll<HTMLElement>('.modal-dot');
  let current      = 0;

  function openModal(index: number) {
    current = index;
    renderModal();
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  function renderModal() {
    const source = document.getElementById(`gmp-${current}`);
    svgSlot.innerHTML = '';
    if (source?.firstElementChild) {
      svgSlot.appendChild(source.firstElementChild.cloneNode(true));
    }
    const info = galeriaData[current];
    nombreEl.textContent  = info.nombre;
    matEl.textContent     = info.mat;
    counterEl.textContent = `${current + 1} / ${galeriaData.length}`;
    waLink.href = `https://wa.me/525512345678?text=${encodeURIComponent(`Hola, vi esta piñata en su galería y quiero una igual:\n• ${info.nombre}\n• ${info.mat}\n\n¿Me dan precio y disponibilidad?`)}`;
    dots.forEach((d, i) => {
      d.style.background = i === current ? 'var(--guinda)' : '#fff';
    });
  }

  document.querySelectorAll<HTMLElement>('.gallery-card').forEach(card => {
    card.addEventListener('click', () => openModal(Number(card.dataset.index)));
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  prevBtn.addEventListener('click', () => {
    current = (current - 1 + galeriaData.length) % galeriaData.length;
    renderModal();
  });
  nextBtn.addEventListener('click', () => {
    current = (current + 1) % galeriaData.length;
    renderModal();
  });

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      current = Number(dot.dataset.dot);
      renderModal();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (!modal.classList.contains('open')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft')  { current = (current - 1 + galeriaData.length) % galeriaData.length; renderModal(); }
    if (e.key === 'ArrowRight') { current = (current + 1) % galeriaData.length; renderModal(); }
  });

  // ── Configurador: toggle activo en grupos de botones
  document.querySelectorAll<HTMLButtonElement>('.opt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.group;
      document.querySelectorAll<HTMLButtonElement>(`.opt-btn[data-group="${group}"]`).forEach(b => {
        b.classList.remove('active');
        b.style.background = '#fff';
        b.style.color = 'var(--tinta)';
        b.style.borderColor = 'var(--tinta)';
      });
      btn.classList.add('active');
      btn.style.background = 'var(--guinda)';
      btn.style.color = '#fff';
      btn.style.borderColor = 'var(--guinda)';

      // Actualizar link de WhatsApp con selecciones
      const forma    = document.querySelector<HTMLButtonElement>('.opt-btn[data-group="forma"].active')?.dataset.val ?? '7 picos';
      const tamano   = document.querySelector<HTMLButtonElement>('.opt-btn[data-group="tamano"].active')?.dataset.val ?? 'Tradicional';
      const matPicos = document.querySelector<HTMLButtonElement>('.opt-btn[data-group="mat-picos"].active')?.dataset.val ?? 'Metálico';
      const matCuerp = document.querySelector<HTMLButtonElement>('.opt-btn[data-group="mat-cuerpo"].active')?.dataset.val ?? 'Papelitos';
      const msg = `Hola, quiero cotizar una piñata: Estrella de ${forma}, tamaño ${tamano}, picos en ${matPicos}, cuerpo en ${matCuerp}.`;
      const waBtn = document.getElementById('wa-config-btn') as HTMLAnchorElement;
      if (waBtn) waBtn.href = `https://wa.me/525512345678?text=${encodeURIComponent(msg)}`;
    });
  });
</script>

</body>
</html>
