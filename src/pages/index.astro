  <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding:0 48px;max-width:1200px;margin:0 auto">
    <div>
      <h6 class="display" style="font-size:22px;margin:0 0 14px;color:var(--amarillo)">Piñatas La Estrella</h6>
