<style>
  .prod-card { transition: transform .15s, box-shadow .15s; }
  .prod-card:hover { transform: translate(-3px,-3px); box-shadow: 11px 11px 0 var(--tinta) !important; }
  .prod-card[hidden] { display: none !important; }
  .filter-btn:hover:not(.active) { background: var(--amarillo) !important; }
  .filter-btn.active { background: var(--guinda) !important; color: #fff !important; border-color: var(--guinda) !important; }
  #cat-modal.open { display: flex !important; }
  #cat-svg-slot svg { animation: fadeUp .22s ease; }
  #cat-prev:hover, #cat-next:hover { background: var(--amarillo) !important; }
  #cat-close:hover { background: var(--guinda) !important; color: #fff; }
  #nav-toggle:hover { background: var(--amarillo) !important; }
  #nav-links.open { display: flex !important; }
  @media (max-width: 900px) {
    #nav-bar { padding-left: 20px !important; padding-right: 20px !important; }
    #nav-links {
      display: none !important;
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; gap: 2px; padding: 10px 20px 18px !important;
      background: var(--crema); border-bottom: 2px dashed rgba(168,35,31,.25);
      box-shadow: 0 8px 16px rgba(0,0,0,.08); font-size: 16px !important;
    }
    #nav-links li { border-top: 1px solid rgba(42,26,16,.08); }
    #nav-links li a { display: block; padding: 13px 4px; }
    #nav-toggle { display: flex !important; }
    #catalog-grid { grid-template-columns: 1fr 1fr !important; }
    section[style*="padding:0 48px"],
    div[style*="padding:0 48px"] { padding-left: 20px !important; padding-right: 20px !important; }
    #footer-bottom { flex-direction: column !important; gap: 6px; text-align: center; padding-bottom: 76px !important; }
  }
  @media (max-width: 600px) {
    #catalog-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 560px) {
    #nav-cta-text { display: none; }
    nav a[href^="mailto"] { padding: 11px !important; }
  }
</style>

<script>
  // ── Menú móvil (hamburguesa) ───────────────────────────────────────
  const navToggle = document.getElementById('nav-toggle');
  const navLinks  = document.getElementById('nav-links');
  const navIconOpen  = document.getElementById('nav-icon-open');
  const navIconClose = document.getElementById('nav-icon-close');

  navToggle?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', String(!!isOpen));
    if (navIconOpen)  navIconOpen.style.display  = isOpen ? 'none' : '';
    if (navIconClose) navIconClose.style.display = isOpen ? '' : 'none';
  });

  navLinks?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navLinks.classList.remove('open');
    navToggle?.setAttribute('aria-expanded', 'false');
    if (navIconOpen)  navIconOpen.style.display  = '';
    if (navIconClose) navIconClose.style.display = 'none';
  }));

  const cards      = document.querySelectorAll<HTMLElement>('.prod-card');
  const countLabel = document.getElementById('count-label');

  let activePicos  = 'todas';
  let activeTamano = 'todos';
  let activeTipo   = 'todos';

  // ── Filtros ──────────────────────────────────────────────────────────
  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const grupoOk  = activePicos  === 'todas' || card.dataset.grupo === activePicos;
      const tamanos  = (card.dataset.tamanos ?? '').split(' ');
      const tamanoOk = activeTamano === 'todos' || tamanos.includes(activeTamano);
      const tipoOk   = activeTipo   === 'todos' || card.dataset.tipo === activeTipo;
      if (grupoOk && tamanoOk && tipoOk) { card.removeAttribute('hidden'); visible++; }
      else card.setAttribute('hidden', '');
    });
    if (countLabel) countLabel.textContent = `${visible} piñata${visible !== 1 ? 's' : ''}`;
  }

  function setActiveButton(selector: string, val: string, activeBg: string) {
    document.querySelectorAll<HTMLElement>(selector).forEach(b => {
      const isActive = b.dataset.filter === val;
      b.classList.toggle('active', isActive);
      b.style.background = isActive ? activeBg : '#fff';
      b.style.color = isActive ? '#fff' : 'inherit';
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-picos').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.filter-picos').forEach(b => {
        b.style.background = '#fff'; b.style.color = 'inherit'; b.classList.remove('active');
      });
      btn.classList.add('active'); btn.style.background = 'var(--guinda)'; btn.style.color = '#fff';
      activePicos = btn.dataset.filter ?? 'todas';
      applyFilters();
      closeModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.filter-tamano').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.filter-tamano').forEach(b => {
        b.style.background = '#fff'; b.style.color = 'inherit'; b.classList.remove('active');
      });
      btn.classList.add('active'); btn.style.background = 'var(--verde)'; btn.style.color = '#fff';
      activeTamano = btn.dataset.filter ?? 'todos';
      applyFilters();
      closeModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.filter-tipo').forEach(btn => {
    btn.addEventListener('click', () => {
      activeTipo = btn.dataset.filter ?? 'todos';
      setActiveButton('.filter-tipo', activeTipo, 'var(--azul)');
      applyFilters();
      closeModal();
    });
  });

  // ── Preseleccionar filtro desde la URL (ej. /catalogo?tipo=dulcera) ───
  const params = new URLSearchParams(window.location.search);
  const tipoParam = params.get('tipo');
  if (tipoParam === 'dulcera' || tipoParam === 'exhibicion') {
    activeTipo = tipoParam;
    setActiveButton('.filter-tipo', activeTipo, 'var(--azul)');
  }
  applyFilters();

  // ── Modal ────────────────────────────────────────────────────────────
  const modal     = document.getElementById('cat-modal')!;
  const backdrop  = document.getElementById('cat-backdrop')!;
  const closeBtn  = document.getElementById('cat-close')!;
  const prevBtn   = document.getElementById('cat-prev')!;
  const nextBtn   = document.getElementById('cat-next')!;
  const svgSlot   = document.getElementById('cat-svg-slot')!;
  const badgeEl   = document.getElementById('cat-badge')!;
  const nombreEl  = document.getElementById('cat-nombre')!;
  const descEl    = document.getElementById('cat-desc')!;
  const matEl     = document.getElementById('cat-mat')!;
  const counterEl = document.getElementById('cat-counter')!;
  const dotsEl    = document.getElementById('cat-dots')!;
  const waLink    = document.getElementById('cat-wa') as HTMLAnchorElement;

  let visibleSeq: number[] = [];
  let pos = 0;

  function getVisible() {
    return [...document.querySelectorAll<HTMLElement>('.prod-card')]
      .filter(c => !c.hasAttribute('hidden'))
      .map(c => Number(c.dataset.index));
  }

  function renderDots() {
    dotsEl.innerHTML = '';
    visibleSeq.forEach((_, i) => {
      const d = document.createElement('button');
      d.style.cssText = `width:9px;height:9px;border-radius:50%;border:2px solid var(--tinta);background:${i===pos?'var(--guinda)':'#fff'};cursor:pointer;padding:0`;
      d.addEventListener('click', () => { pos = i; renderModal(); });
      dotsEl.appendChild(d);
    });
  }

  function renderModal() {
    const idx = visibleSeq[pos];
    const src = document.getElementById(`cp-${idx}`);
    // SVG
    svgSlot.innerHTML = '';
    if (src?.firstElementChild) svgSlot.appendChild(src.firstElementChild.cloneNode(true));
    // Datos desde atributos DOM
    badgeEl.textContent   = src?.dataset.badge   ?? '';
    nombreEl.textContent  = src?.dataset.nombre  ?? '';
    descEl.textContent    = src?.dataset.desc    ?? '';
    matEl.textContent     = src?.dataset.mat     ?? '';
    waLink.href           = src?.dataset.wa      ?? '#';
    counterEl.textContent = `${pos + 1} / ${visibleSeq.length}`;
    renderDots();
  }

  function openModal(origIdx: number) {
    visibleSeq = getVisible();
    pos = visibleSeq.indexOf(origIdx);
    if (pos < 0) pos = 0;
    renderModal();
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  cards.forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      openModal(Number(card.dataset.index));
    });
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  prevBtn.addEventListener('click', () => { pos = (pos - 1 + visibleSeq.length) % visibleSeq.length; renderModal(); });
  nextBtn.addEventListener('click', () => { pos = (pos + 1) % visibleSeq.length; renderModal(); });
  document.addEventListener('keydown', (e) => {
    if (!modal.classList.contains('open')) return;
    if (e.key === 'Escape')      closeModal();
    if (e.key === 'ArrowLeft')  { pos = (pos - 1 + visibleSeq.length) % visibleSeq.length; renderModal(); }
    if (e.key === 'ArrowRight') { pos = (pos + 1) % visibleSeq.length; renderModal(); }
  });
</script>

</body>
</html>
