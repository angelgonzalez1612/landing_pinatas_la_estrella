---
interface Props {
  picos?: string;
  forrado?: string;
  mechudos?: string;
  numPicos?: number;
  size?: number;
  rotate?: number;
}

const {
  picos = '#c25a1f',
  forrado = '#b8893a',
  mechudos = '#c25a1f',
  numPicos = 5,
  size = 200,
  rotate = 0,
} = Astro.props;

function shade(hex: string, amt: number): string {
  const c = hex.replace('#', '');
  const num = parseInt(c, 16);
  const r = Math.max(0, Math.min(255, (num >> 16) + amt));
  const g = Math.max(0, Math.min(255, ((num >> 8) & 0xff) + amt));
  const b = Math.max(0, Math.min(255, (num & 0xff) + amt));
  return '#' + ((r << 16) | (g << 8) | b).toString(16).padStart(6, '0');
}

const cx = 100, cy = 100;
const innerR = 28;
const peakR = 90;
const peakBaseW = 0.45;
const mechudoLength = 18;
const angleStep = (Math.PI * 2) / numPicos;
const startAngle = -Math.PI / 2 + angleStep / 2;

const picoArr = Array.from({ length: numPicos }, (_, i) => {
  const a = startAngle + i * angleStep;
  const tipX = cx + Math.cos(a) * peakR;
  const tipY = cy + Math.sin(a) * peakR;
  const halfW = angleStep * peakBaseW;
  const b1x = cx + Math.cos(a - halfW) * innerR;
  const b1y = cy + Math.sin(a - halfW) * innerR;
  const b2x = cx + Math.cos(a + halfW) * innerR;
  const b2y = cy + Math.sin(a + halfW) * innerR;
  const midX = cx + Math.cos(a) * (innerR + (peakR - innerR) * 0.5);
  const midY = cy + Math.sin(a) * (innerR + (peakR - innerR) * 0.5);
  const mex = tipX + Math.cos(a) * mechudoLength;
  const mey = tipY + Math.sin(a) * mechudoLength;
  const offsets = [-3, -1.5, 0, 1.5, 3];
  const mechLines = offsets.map(off => ({
    sx: tipX + (-Math.sin(a)) * off * 0.3,
    sy: tipY + Math.cos(a) * off * 0.3,
    ex: mex + off * 0.4,
    ey: mey + Math.abs(off) * 0.3,
  }));
  return { tipX, tipY, b1x, b1y, b2x, b2y, midX, midY, mechLines };
});

const picosDark = shade(picos, -30);
const picosLight = shade(picos, 30);
const forradoDark = shade(forrado, -25);
const forradoLight = shade(forrado, 20);
---

<svg
  class="pinata-svg"
  viewBox="0 0 200 200"
  width={size}
  height={size}
  style={`overflow:visible;display:block;transform:rotate(${rotate}deg)`}
>
  <!-- Mechudos -->
  {picoArr.map(p =>
    p.mechLines.map((l, j) => (
      <line
        x1={l.sx} y1={l.sy}
        x2={l.ex} y2={l.ey}
        stroke={mechudos}
        stroke-width="0.9"
        stroke-linecap="round"
        opacity={0.65 + j * 0.06}
      />
    ))
  )}
  {picoArr.map(p => (
    <circle cx={p.tipX} cy={p.tipY} r="2.2" fill={mechudos} opacity="0.85" />
  ))}

  <!-- Picos -->
  {picoArr.map(p => (
    <>
      <path
        d={`M ${p.b1x.toFixed(1)} ${p.b1y.toFixed(1)} L ${p.tipX.toFixed(1)} ${p.tipY.toFixed(1)} L ${p.midX.toFixed(1)} ${p.midY.toFixed(1)} Z`}
        fill={picos}
        stroke={picosDark}
        stroke-width="0.4"
        opacity="0.95"
      />
      <path
        d={`M ${p.b2x.toFixed(1)} ${p.b2y.toFixed(1)} L ${p.tipX.toFixed(1)} ${p.tipY.toFixed(1)} L ${p.midX.toFixed(1)} ${p.midY.toFixed(1)} Z`}
        fill={picos}
        stroke={picosDark}
        stroke-width="0.4"
        opacity="0.7"
      />
      <path
        d={`M ${p.b2x.toFixed(1)} ${p.b2y.toFixed(1)} L ${p.tipX.toFixed(1)} ${p.tipY.toFixed(1)} L ${p.midX.toFixed(1)} ${p.midY.toFixed(1)} Z`}
        fill={picosDark}
        opacity="0.22"
      />
    </>
  ))}

  <!-- Forrado central -->
  <circle cx={cx} cy={cy} r={innerR + 2} fill={forrado} stroke={forradoDark} stroke-width="0.6" />
  <ellipse cx={cx - 8} cy={cy - 8} rx="10" ry="6" fill={forradoLight} opacity="0.35" />

  <!-- Cuerda -->
  <line x1={cx} y1={cy - innerR - 2} x2={cx} y2={cy - innerR - 14} stroke="#8b7355" stroke-width="0.7" />
</svg>
